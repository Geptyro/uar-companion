# Dev-only overrides (copy to .env — gitignored; packaged builds ignore it).
# Point the app at a locally running website and keep its data (config,
# cookies, log) out of the real profile.
UAR_COMPANION_SERVER=http://localhost:5173
UAR_COMPANION_DATA=/home/you/.config/uar-companion-dev

# Other hooks: UAR_COMPANION_THEME=light|dark, UAR_COMPANION_TEST_TOAST=1,
# UAR_COMPANION_WAYLAND=1 (opt back into native Wayland on Linux).

{
	"name": "uar-companion",
	"productName": "UAR Companion",
	"version": "0.7.0",
	"description": "Undead Assault Reborn companion: auto-uploads your SC2 replays to uar.cedricdessalles.dev and shows who is ready to play",
	"type": "module",
	"main": "./out/main/index.js",
	"author": "C\u00e9dric Dessalles",
	"license": "MIT",
	"scripts": {
		"dev": "electron-vite dev",
		"build": "electron-vite build",
		"start": "electron-vite preview",
		"test": "node --test \"tests/*.test.ts\"",
		"e2e": "bash tests/e2e.sh",
		"dist:linux": "electron-vite build && electron-builder --linux --publish never",
		"dist:win": "electron-vite build && electron-builder --win --publish never",
		"dist:mac": "electron-vite build && electron-builder --mac --publish never",
		"link:shared": "npm i ../shared --no-save --install-links",
		"unlink:shared": "npm i",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"release": "node scripts/release.ts",
		"link:commons": "npm i ../../sveltekit-commons --no-save --install-links"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"electron-updater": "^6.8.9",
		"fast-glob": "^3.3.3",
		"seek-bzip": "^2.0.0",
		"sveltekit-commons": "git+https://github.com/Geptyro/sveltekit-commons.git#semver:^0.6.0",
		"uar-shared": "git+https://github.com/Geptyro/uar-shared.git#semver:^0.8.0"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@types/node": "^24.0.0",
		"electron": "^43.2.0",
		"electron-builder": "^26.0.12",
		"electron-vite": "^4.0.1",
		"svelte": "^5.0.0",
		"svelte-check": "^4.7.3",
		"typescript": "^5.9.0"
	},
	"allowScripts": {
		"electron@43.2.0": true,
		"esbuild@0.25.12": true,
		"esbuild@0.28.1": true,
		"electron-winstaller@5.4.0": true
	}
}
